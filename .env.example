APP_NAME=StudyBot
ENVIRONMENT=local
DATABASE_URL=sqlite:///./studybot.db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
LLM_PROVIDER=fake
PORT=8000

# Optional real answer provider.
# LLM_PROVIDER=groq
# GROQ_API_KEY=your-groq-api-key
# LLM_MODEL=openai/gpt-oss-20b

# Real AI generations share these per-user and project budgets.
# Each answer, quiz, or flashcard set is one attempt; daily windows reset at midnight UTC.
AI_USER_DAILY_LIMIT=20
AI_USER_MINUTE_LIMIT=3
AI_PROJECT_DAILY_LIMIT=100
AI_PROJECT_MINUTE_LIMIT=10

# Upload limits; stored note bytes include UTF-8 chunk text and chunk overlap.
UPLOAD_MAX_BYTES=2097152
UPLOAD_MAX_PDF_PAGES=100
UPLOAD_MAX_TEXT_CHARS=200000
STORAGE_USER_DOCUMENT_LIMIT=20
STORAGE_USER_TEXT_BYTES=2097152
STORAGE_PROJECT_DOCUMENT_LIMIT=500
STORAGE_PROJECT_TEXT_BYTES=52428800
UPLOAD_USER_HOURLY_LIMIT=10
UPLOAD_IP_HOURLY_LIMIT=30
UPLOAD_PROJECT_HOURLY_LIMIT=100

# Optional real embedding provider.
# EMBEDDING_PROVIDER=openai
# EMBEDDING_API_KEY=your-openai-api-key
# OPENAI_API_KEY=your-openai-api-key
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=

# Local frontend demo origins.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Production example. Use the deployed frontend origin and a managed database.
# ENVIRONMENT=production
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/studybot
# CORS_ORIGINS=https://studybot.example.com
AUTH_SESSION_HOURS=24

# Disabled until a sender is configured. Use a dedicated mailbox for staging.
EMAIL_PROVIDER=disabled
PUBLIC_APP_URL=http://127.0.0.1:8000
AUTH_REQUIRE_EMAIL_VERIFICATION=false
AUTH_RESET_MINUTES=15
AUTH_VERIFY_HOURS=24
AUTH_EMAIL_IP_LIMIT=10
AUTH_EMAIL_ADDRESS_LIMIT=3
AUTH_EMAIL_PROJECT_DAILY_LIMIT=100
# EMAIL_PROVIDER=smtp
# EMAIL_FROM=your-sender@gmail.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USERNAME=your-sender@gmail.com
# SMTP_PASSWORD=your-app-password-secret
# PUBLIC_APP_URL=https://studybot-staging.vercel.app
# Port 587 uses mandatory STARTTLS; 465 uses TLS from connection start.
SMTP_TIMEOUT_SECONDS=5

# Shared authentication limits (positive values only).
AUTH_LOGIN_IP_LIMIT=30
AUTH_LOGIN_EMAIL_LIMIT=10
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_SIGNUP_IP_LIMIT=10
AUTH_SIGNUP_WINDOW_SECONDS=3600
# Defaults to direct; Vercel automatically selects vercel when VERCEL=1.
# Set vercel only for functions reached exclusively through Vercel's gateway.
# AUTH_CLIENT_IP_SOURCE=direct
