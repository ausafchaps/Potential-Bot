{
  "name": "retrieval_v1",
  "description": "Small keyword-retrieval baseline for StudyBot course material search.",
  "cases": [
    {
      "id": "binary_search_exact_match",
      "query": "binary search halves sorted array",
      "top_k": 3,
      "documents": [
        {
          "filename": "binary-search.txt",
          "chunks": [
            {
              "text": "Binary search halves a sorted array repeatedly until it finds the target value."
            }
          ]
        },
        {
          "filename": "linear-search.txt",
          "chunks": [
            {
              "text": "Linear search checks each element one by one until it finds the target value."
            }
          ]
        }
      ],
      "expected_results": [
        {
          "filename": "binary-search.txt",
          "chunk_index": 0
        }
      ]
    },
    {
